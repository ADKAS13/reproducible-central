# telegrambots-7.7.0.buildspec
groupId=org.telegram
artifactId=Bots
version=10.0.0

gitRepo=https://github.com/ADKAS13/TelegramBots1.git
gitTag=3f0c7a5

tool=mvn
jdk=17
newline=lf
umask=022

command="mvn com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:init com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:flatten clean install -Denforcer.skip=true -Dgpg.skip=true"
buildinfo=target/Bots-10.0.0.mod.buildinfo