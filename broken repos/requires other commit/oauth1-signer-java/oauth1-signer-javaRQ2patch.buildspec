groupId=com.mastercard.developer
artifactId=oauth1-signer
version=9

gitRepo=https://github.com/Mastercard/oauth1-signer-java.git
gitTag=a582acbb0dd1c382705c762c9774522fc330bdf3

tool=mvn
jdk=11
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete && mvn clean com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:init -DallowVersionRanges=patch com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:flatten install\""

buildinfo=target/Oauth1-signer-java.buildinfo
