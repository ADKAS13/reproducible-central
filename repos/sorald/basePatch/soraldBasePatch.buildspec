groupId=se.kth.castor
artifactId=sorald
version=9

gitRepo=https://github.com/ASSERT-KTH/sorald.git
gitTag=87ce9cc379184fe141dc6dea98e344f21f461818

tool=mvn
jdk=11
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete &&
    mvn -Dmaven.test.failure.ignore=true -Dmaven.javadoc.skip=true com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:range-test -DallowVersionRanges=patch install &&
    find . -type d \( -name surefire-reports -o -name failsafe-reports \) -exec rm -rf {} + &&
    mvn -Dmaven.test.failure.ignore=true -Dmaven.javadoc.skip=true -DskipTests com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:range-compare install &&
    find . -name 'pom.deps.xml' -delete && mvn -Dmaven.test.failure.ignore=true install -Dmaven.javadoc.skip=true\""

buildinfo=target/Sorald.buildinfo
