groupId=org.opensextant
artifactId=opensextant-xponents
version=9

gitRepo=https://github.com/OpenSextant/Xponents.git
gitTag=4ea69afcc22aa417c72f34c068cadce9796bd251

tool=mvn
jdk=11
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete && mvn clean com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:init -DallowVersionRanges=major com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:flatten install -DskipTests -Dmaven.test.failure.ignore=true && mvn install -Dmaven.test.failure.ignore=true\""

buildinfo=target/Xponents.buildinfo
