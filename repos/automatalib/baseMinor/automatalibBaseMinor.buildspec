# automatalib.buildspec
groupId=net.automatalib
artifactId=automata-parent
version=9

gitRepo=https://github.com/LearnLib/automatalib.git
gitTag=3cfc64a

tool=mvn
jdk=8
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete && mvn -Dmaven.test.failure.ignore=true com.baeldung:lock-plugin:1.0-SNAPSHOT:range-test -DallowVersionRanges=minor &&
    mvn clean install\""

buildinfo=target/Automata.buildinfo
