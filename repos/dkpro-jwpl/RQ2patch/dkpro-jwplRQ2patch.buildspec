groupId=de.tudarmstadt.ukp.wikipedia
artifactId=de.tudarmstadt.ukp.wikipedia
version=9

gitRepo=https://github.com/dkpro/dkpro-jwpl.git
gitTag=0a0304b6a0aa13acc18838957994e06dd4613a58

tool=mvn
jdk=8
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete && mvn clean com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:init -DallowVersionRanges=patch com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:flatten install -Dmaven.test.failure.ignore=true\""

buildinfo=target/Dkpro-jwpl.buildinfo
