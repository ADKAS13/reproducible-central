groupId=org.jboss.weld
artifactId=weld-api-parent
version=9

gitRepo=https://github.com/weld/api.git
gitTag=db490c3e4c9d63869d6ce90c3e3e5b9409d1aa79

tool=mvn
jdk=8
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete && mvn clean com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:init com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:flatten install -DskipTests && mvn clean install\""

buildinfo=target/Api.buildinfo
