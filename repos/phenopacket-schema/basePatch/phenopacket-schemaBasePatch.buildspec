groupId=org.phenopackets
artifactId=phenopacket-schema
version=9

gitRepo=https://github.com/ga4gh/phenopacket-schema.git
gitTag=2090c54b4cd68e1d44aab8b067d0b0def0f8a30c

tool=mvn
jdk=11
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete &&
    mvn -Dmaven.test.failure.ignore=true com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:range-test -DallowVersionRanges=patch install &&
    find . -type d \( -name surefire-reports -o -name failsafe-reports \) -exec rm -rf {} + &&
    mvn -Dmaven.test.failure.ignore=true -DskipTests com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:range-compare install &&
    find . -name 'pom.deps.xml' -delete && mvn -Dmaven.test.failure.ignore=true install\""

buildinfo=target/Phenopacket-schema.buildinfo
