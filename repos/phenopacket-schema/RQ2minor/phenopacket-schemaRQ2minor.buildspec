groupId=org.phenopackets
artifactId=phenopacket-schema
version=9

gitRepo=https://github.com/ga4gh/phenopacket-schema.git
gitTag=2090c54b4cd68e1d44aab8b067d0b0def0f8a30c

tool=mvn
jdk=11
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete && mvn clean com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:init -DallowVersionRanges=minor com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:flatten install -DskipTests && mvn -Dmaven.test.failure.ignore=true clean install\""

buildinfo=target/Phenopacket-schema.buildinfo
