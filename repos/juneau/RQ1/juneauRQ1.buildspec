groupId=org.apache.juneau
artifactId=juneau
version=9

gitRepo=https://github.com/apache/juneau.git
gitTag=801c636e9badfa6c38e15d5590bfb0b6ec0caa00

tool=mvn
jdk=8
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete && mvn clean com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:init com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:flatten install -DskipTests -Dmaven.test.failure.ignore=true && mvn install -Dmaven.test.failure.ignore=true\""

buildinfo=target/Juneau.buildinfo
