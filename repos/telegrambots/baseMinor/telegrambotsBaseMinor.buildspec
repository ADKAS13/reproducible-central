# telegrambots-7.7.0.buildspec
groupId=org.telegram
artifactId=Bots
version=10.0.0

gitRepo=https://github.com/ADKAS13/TelegramBots1.git
gitTag=3f0c7a5

tool=mvn
jdk=17
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete && mvn com.baeldung:lock-plugin:1.0-SNAPSHOT:range-test -DallowVersionRanges=minor &&
    mvn clean install -Denforcer.skip=true -Dgpg.skip=true\""
buildinfo=target/Bots-10.0.0.buildinfo