# automatalib.buildspec

groupId=com.google.cloud.trace
artifactId=root
version=0.8.0

gitRepo=https://github.com/GoogleCloudPlatform/cloud-trace-java.git
gitTag=9aa2f22e571577887053a86d2236830b3922421b

tool=mvn
jdk=8
newline=lf
umask=022
tool=mvn

command="sh -c \"find . -name 'pom.deps.xml' -delete && mvn clean com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:init -DallowVersionRanges=minor com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:flatten install -DskipTests && mvn -Dmaven.test.failure.ignore=true clean install\""

buildinfo=target/test.buildinfo
