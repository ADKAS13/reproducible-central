# automatalib.buildspec

groupId=com.google.cloud.trace
artifactId=root
version=0.8.0

gitRepo=https://github.com/GoogleCloudPlatform/cloud-trace-java.git
gitTag=9aa2f22e571577887053a86d2236830b3922421b

tool=mvn
jdk=8
newline=lf
umask=022
tool=mvn

command="sh -c \"find . -name 'pom.deps.xml' -delete && mvn -Dmaven.test.failure.ignore=true com.baeldung:lock-plugin:1.0-SNAPSHOT:range-test -DallowVersionRanges=minor &&
    mvn clean install\""

buildinfo=target/test.buildinfo
