# beekeeper.buildspec
groupId=org.opengis.cite
artifactId=teamengine
version=4.0.0

gitRepo=https://github.com/opengeospatial/teamengine.git
gitTag=7b6c97a7a1c1fb0233209b39261f3d187363b8c6

tool=mvn
jdk=8
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete && mvn clean com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:init -DallowVersionRanges=minor com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:flatten install -Dmaven.javadoc.skip=true -Denforcer.skip=true\""

buildinfo=target/beekeeper.buildinfo