# beekeeper.buildspec
groupId=org.opengis.cite
artifactId=teamengine
version=4.0.0

gitRepo=https://github.com/opengeospatial/teamengine.git
gitTag=7b6c97a7a1c1fb0233209b39261f3d187363b8c6

tool=mvn
jdk=8
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete &&
    mvn -Dmaven.test.failure.ignore=true -Dmaven.javadoc.skip=true -Denforcer.skip=true com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:range-test -DallowVersionRanges=major install &&
    find . -type d \( -name surefire-reports -o -name failsafe-reports \) -exec rm -rf {} + &&
    mvn -Dmaven.test.failure.ignore=true -Dmaven.javadoc.skip=true -Denforcer.skip=true -DskipTests com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:range-compare install &&
    find . -name 'pom.deps.xml' -delete && mvn -Dmaven.test.failure.ignore=true install -Dmaven.javadoc.skip=true -Denforcer.skip=true\""

buildinfo=target/beekeeper.buildinfo
