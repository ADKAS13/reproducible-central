groupId=com.helger.peppol
artifactId=peppol-commons-parent-pom
version=9

gitRepo=https://github.com/phax/peppol-commons.git
gitTag=86ea56872d3f1ed495dc78e247b874d2dfcc27bb

tool=mvn
jdk=11
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete && mvn clean com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:init com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:flatten install -DskipTests && mvn -Dmaven.test.failure.ignore=true clean install\""

buildinfo=target/Peppol-commons.buildinfo
