groupId=org.apache.maven.plugins
artifactId=maven-checkstyle-plugin
version=9

gitRepo=https://github.com/apache/maven-checkstyle-plugin.git
gitTag=b1ad0bbbf077d5670cf679043076b9a1691ce4cc

tool=mvn
jdk=11
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete && mvn clean com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:init -DallowVersionRanges=patch com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:flatten install -DskipTests && mvn -Dmaven.test.failure.ignore=true clean install\""

buildinfo=target/Maven-checkstyle-plugin.buildinfo
