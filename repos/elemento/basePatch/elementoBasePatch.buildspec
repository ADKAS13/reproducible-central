groupId=org.jboss.elemento
artifactId=elemento-parent
version=9

gitRepo=https://github.com/hal/elemento.git
gitTag=07806758a88e59f7ce99d4baeb08158afeb8db06

tool=mvn
jdk=11
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete && mvn -Dmaven.test.failure.ignore=true com.baeldung:lock-plugin:1.0-SNAPSHOT:range-test -DallowVersionRanges=patch &&
    mvn clean install\""

buildinfo=target/Elemento.buildinfo
