groupId=com.thoughtworks.gauge
artifactId=gauge-java
version=9

gitRepo=https://github.com/getgauge/gauge-java.git
gitTag=5ae7753ddb46dc0b32bb87bc34f89d942c67c461

tool=mvn
jdk=11
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete && mvn com.baeldung:lock-plugin:1.0-SNAPSHOT:range-test -DallowVersionRanges=patch &&
    mvn clean install -Dgpg.skip=true\""

buildinfo=target/Gauge-java.buildinfo
