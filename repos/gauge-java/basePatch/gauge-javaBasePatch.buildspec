groupId=com.thoughtworks.gauge
artifactId=gauge-java
version=9

gitRepo=https://github.com/getgauge/gauge-java.git
gitTag=5ae7753ddb46dc0b32bb87bc34f89d942c67c461

tool=mvn
jdk=11
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete &&
    mvn -Dmaven.test.failure.ignore=true -Dgpg.skip=true com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:range-test -DallowVersionRanges=patch install &&
    find . -type d \( -name surefire-reports -o -name failsafe-reports \) -exec rm -rf {} + &&
    mvn -Dmaven.test.failure.ignore=true -Dgpg.skip=true -DskipTests com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:range-compare install &&
    find . -name 'pom.deps.xml' -delete && mvn -Dmaven.test.failure.ignore=true install -Dgpg.skip=true\""

buildinfo=target/Gauge-java.buildinfo
