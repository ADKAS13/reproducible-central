groupId=nl.obren.sokrates
artifactId=sokrates
version=9

gitRepo=https://github.com/zeljkoobrenovic/sokrates.git
gitTag=3e7b48d43e2ecd1f6b10722530a67694514376b2

tool=mvn
jdk=17
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete && mvn clean com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:init -DallowVersionRanges=major com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:flatten install -DskipTests && mvn clean install\""

buildinfo=target/Sokrates.buildinfo
