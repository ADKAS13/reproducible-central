groupId=org.alfasoftware
artifactId=astra
version=9

gitRepo=https://github.com/alfasoftware/astra.git
gitTag=bbc6407425ec3d7613cc4c3ee003e5480d78dedd

tool=mvn
jdk=17
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete &&
    mvn -Dmaven.test.failure.ignore=true -Dmaven.javadoc.skip=true com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:range-test -DallowVersionRanges=minor install &&
    find . -type d \( -name surefire-reports -o -name failsafe-reports \) -exec rm -rf {} + &&
    mvn -Dmaven.test.failure.ignore=true -Dmaven.javadoc.skip=true -DskipTests com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:range-compare install &&
    find . -name 'pom.deps.xml' -delete && mvn -Dmaven.test.failure.ignore=true install -Dmaven.javadoc.skip=true\""

buildinfo=target/Astra.buildinfo
