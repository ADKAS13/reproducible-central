groupId=org.alfasoftware
artifactId=astra
version=9

gitRepo=https://github.com/alfasoftware/astra.git
gitTag=bbc6407425ec3d7613cc4c3ee003e5480d78dedd

tool=mvn
jdk=17
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete && mvn clean com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:init -DallowVersionRanges=minor com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:flatten install -DskipTests && mvn -Dmaven.test.failure.ignore=true clean install -Dmaven.javadoc.skip=true \""

buildinfo=target/Astra.buildinfo
