groupId=com.google.turbine
artifactId=turbine
version=9

gitRepo=https://github.com/google/turbine.git
gitTag=3d2be5ebe001f9cf7e51c770d1583d87ad2ea084

tool=mvn
jdk=11
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete && mvn clean com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:init -DallowVersionRanges=patch com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:flatten install -DskipTests -Dmaven.test.failure.ignore=true && mvn install -Dmaven.test.failure.ignore=true\""

buildinfo=target/Turbine.buildinfo
