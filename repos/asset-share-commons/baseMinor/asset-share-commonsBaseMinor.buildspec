groupId=com.adobe.aem.commons
artifactId=assetshare
version=9

gitRepo=https://github.com/adobe/asset-share-commons.git
gitTag=a2f294ef6dcd9d14a12dd7a00bd53aa8c314ee2a

tool=mvn
jdk=11
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete && mvn -Dmaven.test.failure.ignore=true com.baeldung:lock-plugin:1.0-SNAPSHOT:range-test -DallowVersionRanges=minor &&
    mvn clean install\""

buildinfo=target/Asset-share-commons.buildinfo
