groupId=com.adobe.aem.commons
artifactId=assetshare
version=9

gitRepo=https://github.com/adobe/asset-share-commons.git
gitTag=a2f294ef6dcd9d14a12dd7a00bd53aa8c314ee2a

tool=mvn
jdk=11
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete &&
    mvn -Dmaven.test.failure.ignore=true com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:range-test -DallowVersionRanges=major install &&
    find . -type d \( -name surefire-reports -o -name failsafe-reports \) -exec rm -rf {} + &&
    mvn -Dmaven.test.failure.ignore=true -DskipTests com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:range-compare install &&
    find . -name 'pom.deps.xml' -delete && mvn -Dmaven.test.failure.ignore=true install\""

buildinfo=target/Asset-share-commons.buildinfo
