groupId=com.saucelabs
artifactId=saucerest
version=9

gitRepo=https://github.com/saucelabs/saucerest-java.git
gitTag=6c510e45bb08d38236cce23915c775d43ab005df

tool=mvn
jdk=8
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete && mvn clean com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:init -DallowVersionRanges=patch com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:flatten install -DskipTests -Dmaven.test.failure.ignore=true -Dgpg.skip=true && mvn install -Dmaven.test.failure.ignore=true -Dgpg.skip=true\""

buildinfo=target/Saucerest-java.buildinfo
