groupId=org.jboss.arquillian.graphene
artifactId=graphene-parent
version=9

gitRepo=https://github.com/arquillian/arquillian-graphene.git
gitTag=6f2930652c58c5299915f6beb9eed5a96b5474c6

tool=mvn
jdk=8
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete && mvn clean com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:init com.baeldung:counter-maven-plugin:1.0-SNAPSHOT:flatten install -DskipTests && mvn -Dmaven.test.failure.ignore=true clean install\""

buildinfo=target/Arquillian-graphene.buildinfo
