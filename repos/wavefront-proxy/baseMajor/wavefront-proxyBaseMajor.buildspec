groupId=com.wavefront
artifactId=wavefront
version=9

gitRepo=https://github.com/Broadcom/wavefront-proxy.git
gitTag=473181a944de2a37701d6ecc6da5e92b5c10a381

tool=mvn
jdk=8
newline=lf
umask=022

command="sh -c \"find . -name 'pom.deps.xml' -delete && mvn com.baeldung:lock-plugin:1.0-SNAPSHOT:range-test -DallowVersionRanges=major &&
    mvn clean install\""

buildinfo=target/Wavefront-proxy.buildinfo
